<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <TargetFrameworks>net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>unvell.ReoGrid</RootNamespace>
    <AssemblyName>unvell.ReoGrid</AssemblyName>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <StartupObject></StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>AvaloniaDebug;AvaloniaRelease;Debug;Release</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG;AVALONIA;GLOBALUSING;EX_SCRIPT;VP_DEBUG_OFF;ALWAYS_CELL_CLIP;FORMULA;LANG_JP;OUTLINE;DRAWING;COMMENT;RICHTEXT;</DefineConstants>
    <LangVersion>default</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;AVALONIA;GLOBALUSING;FORMULA;LANG_JP;OUTLINE;DRAWING;RICHTEXT;</DefineConstants>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
	<PropertyGroup>
		<Authors>Jingwood</Authors>
		<Company>unvell</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://reogrid.net</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryUrl>https://github.com/unvell/ReoGrid/</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<VersionPrefix>3.0.2</VersionPrefix>
		<VersionSuffix></VersionSuffix>
		<PackageId>unvell.ReoGridAvalonia.dll</PackageId>
		<Description>Powerful and lightweight open source .NET spreadsheet component. Compatible with Excel 2007 format or later. Simple APIs to open/edit/save/print an Excel spreadsheet in the .NET application.</Description>
		<SignAssembly>true</SignAssembly>
		<ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">favicon.ico</ApplicationIcon>
		<Copyright>2012-2021 (c) Jingwood, unvell, all rights reserved.</Copyright>
		<PackageTags>spreadsheet excel drawing grid workbook worksheet chart data formula script macro outline print</PackageTags>
		<PackageReleaseNotes>https://github.com/unvell/ReoGrid/releases/tag/v3.0.0</PackageReleaseNotes>
	</PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='AvaloniaDebug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG;AVALONIA;GLOBALUSING;EX_SCRIPT;VP_DEBUG_OFF;ALWAYS_CELL_CLIP;FORMULA;LANG_JP;OUTLINE;DRAWING;COMMENT;RICHTEXT;</DefineConstants>
    <LangVersion>default</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='AvaloniaRelease|AnyCPU'">
    <DefineConstants>TRACE;AVALONIA;GLOBALUSING;FORMULA;LANG_JP;OUTLINE;DRAWING;RICHTEXT;</DefineConstants>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- The TFM is plain net8.0, so the SDK never auto-defines WINDOWS. The
       #if AVALONIA && WINDOWS cursor-init block in Control/ControlShare.cs
       relies on it; define it here on Windows hosts so built-in cursors are
       compiled in on Windows and degrade to Cursor.Default elsewhere. Runs
       after the per-config DefineConstants groups so $(DefineConstants) is
       already populated. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyOriginatorKeyFile></AssemblyOriginatorKeyFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='AvaloniaRelease|net6.0|AnyCPU'">
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Android\**" />
    <Compile Remove="iOS\**" />
    <Compile Remove="Test\**" />
    <Compile Remove="WinForm\**" />
    <Compile Remove="WPF\**" />
    <Content Remove="Android\**" />
    <Content Remove="iOS\**" />
    <Content Remove="Test\**" />
    <Content Remove="WinForm\**" />
    <EmbeddedResource Remove="Android\**" />
    <EmbeddedResource Remove="iOS\**" />
    <EmbeddedResource Remove="Test\**" />
    <EmbeddedResource Remove="WinForm\**" />
    <EmbeddedResource Remove="WPF\**" />
    <None Remove="Android\**" />
    <None Remove="iOS\**" />
    <None Remove="Test\**" />
    <None Remove="WinForm\**" />
    <None Remove="WPF\**" />
    <Page Remove="Android\**" />
    <Page Remove="iOS\**" />
    <Page Remove="Test\**" />
    <Page Remove="WinForm\**" />
    <Page Remove="WPF\**" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaXaml Remove="Avalonia\Base.axaml" />
    <AvaloniaXaml Remove="Avalonia\ControlTheme.axaml" />
    <AvaloniaXaml Remove="Avalonia\TemplatedControl1.axaml" />
    <AvaloniaXaml Remove="Avalonia\UserControl1.axaml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Avalonia\TemplatedControl1.axaml.cs" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Avalonia\Theme\Base.axaml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Antlr3.Runtime" Condition="'$(Configuration)|$(Platform)'=='AvaloniaDebug|AnyCPU'">
      <HintPath>..\Ref\Antlr3.Runtime.dll</HintPath>
    </Reference>
    <Reference Update="System.Core">
      <RequiredTargetFramework>3.5</RequiredTargetFramework>
    </Reference>
    <Reference Update="System.Xml.Linq">
      <RequiredTargetFramework>3.5</RequiredTargetFramework>
    </Reference>
    <!-- unvell.ReoScript.dll is a .NET Framework 2.0 assembly that references
         System.Windows.Forms, which does not exist on Linux. It is only used
         when EX_SCRIPT is defined (Debug / AvaloniaDebug), so gate the
         reference to that to keep it out of the Release / Linux output. -->
    <Reference Include="unvell.ReoScript" Condition="$(DefineConstants.Contains('EX_SCRIPT'))">
      <HintPath>..\Ref\unvell.ReoScript.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Control\ControlShare.cs" />
    <Compile Update="ClipboardMonitor.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\cross.cur" />
		<EmbeddedResource Include="Resources\full_col_select.cur" />
		<EmbeddedResource Include="Resources\full_row_select.cur" />
		<EmbeddedResource Include="Resources\grid_select.cur" />
		<EmbeddedResource Include="Resources\pick_range.cur" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.5" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\NuGet\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\DateTimeFormat.it.resx" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\DateTimeFormat.resx" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>DateTimeFormat.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Avalonia\Base.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>
</Project>